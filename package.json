{
  "name": "ds4-context-engine",
  "version": "0.1.0",
  "description": "Provider-independent, inspectable context planning for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-engine",
    "llm",
    "sqlite"
  ],
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/extension/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"

{
  "name": "ds4-context-engine",
  "version": "0.2.0-beta.2",
  "description": "Non-destructive, provider-independent context management for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Alucard24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alucard24/ds4-context-engine.git"
  },
  "homepage": "https://github.com/Alucard24/ds4-context-engine#readme",
  "bugs": {
    "url": "https://github.com/Alucard24/ds4-context-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-engine",
    "llm",
    "sqlite"
  ],
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "src",
    "docs",
    "quality",
    "scripts/compare-context-quality.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/extension/index.ts"
  },
  "scripts": {
    "build:core": "npm run build --workspace ds4-context-core",
    "build:reference-adapter": "npm run build --workspace ds4-context-reference-adapter",
    "build:adapters": "npm run build:reference-adapter",
    "typecheck": "npm run build:core && npm run build:adapters && tsc --noEmit",
    "test": "npm run build:core && npm run build:adapters && vitest run",
    "test:watch": "npm run build:core && npm run build:adapters && vitest",
    "check": "npm run build:core && npm run build:adapters && tsc --noEmit && vitest run",
    "quality:compare": "node scripts/compare-context-quality.mjs",
    "latency:check": "npm run build:core && node scripts/compare-disabled-planning-latency.mjs",
    "pack:check": "node scripts/verify-packages.mjs",
    "registry:check": "node scripts/verify-registry-packages.mjs",
    "prepare": "npm run build:core && npm run build:adapters"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "dependencies": {
    "ds4-context-core": "0.2.0-beta.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

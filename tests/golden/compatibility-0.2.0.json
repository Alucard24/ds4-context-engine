{
  "releaseLine": "0.2.0",
  "config": {
    "schemaVersion": "ds4-context-config-v1",
    "defaults": {
      "enabled": true,
      "context": {
        "mode": "managed",
        "targetFillRatio": 0.7,
        "softLimitRatio": 0.8,
        "hardLimitRatio": 0.9,
        "minimumOutputReserve": 8192,
        "preferredOutputReserve": 32768,
        "recentTailTokens": 64000,

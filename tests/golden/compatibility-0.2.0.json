        "preserveRecentVerbatim": true,
        "transport": {
          "maxAttempts": 3,
          "baseDelayMs": 2000
        }
      },
      "retrieval": {
        "exact": true,
        "fts": true,
        "semantic": false,
        "maxResults": 12,
        "embedding": {
          "mode": "local",
